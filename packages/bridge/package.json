{
  "name": "@relay/bridge",
  "version": "0.1.0",
  "description": "Turn any web app into an MCP server without a browser. It reads the API endpoints the app's own frontend already reveals (JS bundles, HTML forms, OpenAPI specs), signs in over HTTP, and exposes the endpoints as typed MCP tools.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "relay-bridge": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@relay/core": "workspace:*",
    "node-html-parser": "^6.1.13"
  },
  "devDependencies": {
    "@relay/eslint-config": "workspace:*",
    "@types/node": "^20.14.0",
    "eslint": "^9.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "express": "^4.19.2",
    "@types/express": "^4.17.21",
    "@relay/express": "workspace:*"
  }
}
